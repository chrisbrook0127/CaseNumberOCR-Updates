@@ -0,0 +1,140 @@
+"""v6.0.4 test release: performance only + nonblocking order confirmation."""
+import inspect
+import queue
+import threading
+import tempfile
+import time
+import unittest
+import sys
+from types import SimpleNamespace
+from pathlib import Path
+from unittest.mock import Mock, patch
+import tkinter as tk
+import case_number_ocr as m
+
+
+class InferenceSpeed604(unittest.TestCase):
+    def test_unchanged_generation_settings(self):
+        source=inspect.getsource(m.App._trocr_read_scored_impl)
+        self.assertIn('max_new_tokens=24, num_beams=2',source)
+        self.assertIn('early_stopping=True, return_dict_in_generate=True',source)
+        self.assertIn('with self._perf_measure("trocr_preprocess")',source)
+        self.assertIn('with self._perf_measure("trocr_generate")',source)
+        self.assertIn('with self._perf_measure("trocr_decode_confidence")',source)
+
+    def test_readtext_is_unchanged_when_batch_not_requested(self):
+        app=m.App.__new__(m.App)
+        baseline=[([(0,0),(10,0),(10,5),(0,5)],'08-594',0.972)]
+        app.reader=Mock()
+        app.reader.readtext=Mock(return_value=baseline)
+        app._easyocr_gpu_batch_test_requested=False
+        app._budgeted_ocr=lambda engine,image,callback,empty:callback()
+        app._perf_stages={}
+        result=app._timed_easyocr_readtext('roi',detail=1,paragraph=False)
+        self.assertIs(result,baseline)
+        app.reader.readtext.assert_called_once_with('roi',detail=1,paragraph=False)
+
+    def test_batch_comparison_never_changes_primary_read(self):
+        app=m.App.__new__(m.App)
+        result=[('box','08-594',0.972)]
+        app.reader=Mock(device='cuda:0')
+        app.reader.readtext=Mock(side_effect=lambda _image,**kwargs:result if kwargs['batch_size']<8 else [('box','08-594',0.968)])
+        app._easyocr_gpu_batch_test_requested=True
+        app._easyocr_gpu_batch_test_samples=0
+        app._easyocr_gpu_batch_test_results=[]
+        app._perf_stages={}
+        app._diag_event=Mock()
+        app._log=Mock()
+        app.queue=queue.Queue()
+        fake_torch=SimpleNamespace(cuda=SimpleNamespace(is_available=lambda:True,
+                                                        synchronize=lambda:None))
+        with patch.dict(sys.modules, {'torch':fake_torch}):
+            app._run_gpu_batch_comparison('roi',{'detail':1},result,100.0)
+        self.assertEqual(app._easyocr_gpu_batch_test_samples,1)
+        self.assertEqual([r['batch_size'] for r in app._easyocr_gpu_batch_test_results[0]],[1,2,4,8])
+        self.assertEqual([r['identical'] for r in app._easyocr_gpu_batch_test_results[0]],[True,True,True,False])
+        self.assertEqual(result,[('box','08-594',0.972)])
+        self.assertEqual(app._easyocr_gpu_batch_test_results[0][0]['elapsed_ms'],100.0)
+
+    def test_training_always_has_cpu_thread_restore(self):
+        source=inspect.getsource(m.App._train_trocr_worker)
+        self.assertIn('prior_torch_threads = torch.get_num_threads()',source)
+        self.assertIn('torch.set_num_threads(prior_torch_threads)',source)
+        self.assertIn('finally:',source)
+
+    def test_gpu_install_is_explicit_offline_safe(self):
+        setup=(Path(m.__file__).resolve().parent/'SETUP.bat').read_text(encoding='utf8')
+        self.assertIn('if /I "%~1"=="/GPU" goto gpu_setup',setup)
+        self.assertIn('where nvidia-smi',setup)
+        self.assertIn('choice /C YN',setup)
+        self.assertIn('https://download.pytorch.org/whl/cu126',setup)
+        self.assertNotIn('Invoke-WebRequest -UseBasicParsing \'http',setup.split(':gpu_setup')[-1])
+
+    def test_ocr_training_locations_are_still_available(self):
+        for n in ('_automatic_handwritten_4x4','_scan_one_learned_zone',
+                  '_find_case_candidates','_sequence_consensus_plan',
+                  '_ranked_learned_scan_zones','_check_order_review'):
+            self.assertTrue(hasattr(m.App,n),n)
+
+
+class PopupDoesNotStopScanning604(unittest.TestCase):
+    def test_livescan_confirmation_never_blocks_queue(self):
+        root=tk.Tk()
+        self.addCleanup(lambda:root.destroy() if root.winfo_exists() else None)
+        root.withdraw()
+        app=m.App.__new__(m.App)
+        app.root=root
+        app.busy=True
+        app.records={'i2':{'path':Path('/tmp/Image0002.pdf'),'original_name':'Image0002.pdf',
+                            'sequence_locked':False,'order_review_ack':''}}
+        app._manual_order_problem=Mock(return_value='3 or more cases outside the order')
+        app._audit_event=Mock()
+        app.status=tk.Label(root)
+        app.pause_event=threading.Event();app.pause_event.set()
+        app.stop_event=threading.Event()
+        results=queue.Queue(maxsize=1)
+        received=[];resumed=[]
+        def consume():
+            try:
+                while True:received.append(results.get_nowait())
+            except queue.Empty:pass
+            if len(received)<8:
+                root.after(8,consume)
+        root.after(8,consume)
+        worker=threading.Thread(target=lambda:[results.put(i,timeout=2) for i in range(8)],daemon=True)
+        worker.start()
+        self.assertFalse(app._confirm_out_of_order_change('i2','08-108',resume=lambda:resumed.append(True)))
+        dialog=app._active_order_confirmations['i2']
+        self.assertTrue(dialog.winfo_exists())
+        self.assertIsNone(dialog.grab_current())
+        deadline=time.monotonic()+2
+        while time.monotonic()<deadline and len(received)<8:
+            root.update();time.sleep(.005)
+        worker.join(timeout=.2)
+        self.assertFalse(worker.is_alive(),'bounded scan queue blocked while order dialog remained open')
+        self.assertEqual(received,list(range(8)))
+        self.assertTrue(app.pause_event.is_set())
+        self.assertFalse(app.stop_event.is_set())
+        self.assertTrue(app.busy)
+        self.assertFalse(app.records['i2']['sequence_locked'])
+        # Recursively locate the YES button in the modeless window.
+        def descendants(w):
+            for child in w.winfo_children():
+                yield child
+                yield from descendants(child)
+        yes=next(w for w in descendants(dialog) if isinstance(w,(__import__('tkinter').ttk.Button,)) and 'YES' in w.cget('text'))
+        yes.invoke()
+        root.update()
+        self.assertTrue(app.records['i2']['sequence_locked'])
+        self.assertEqual(app.records['i2']['order_review_ack'],'08-108')
+        self.assertEqual(resumed,[True])
+
+    def test_five_row_context_popup_is_modeless(self):
+        src=inspect.getsource(m.App._show_order_popup)
+        self.assertIn('tk.Toplevel(self.root)',src)
+        self.assertNotIn('grab_set(',src)
+        self.assertNotIn('wait_window(',src)
+        self.assertNotIn('pause_event.clear(',src)
+        self.assertNotIn('stop_event.set(',src)
+
+if __name__=='__main__':unittest.main()
