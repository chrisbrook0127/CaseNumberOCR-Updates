index 0453949..7dbe820 100644
--- a/SETUP.bat
+++ b/SETUP.bat
@@ -1,10 +1,11 @@
 @echo off
 setlocal EnableExtensions EnableDelayedExpansion
 cd /d "%~dp0"
-title M.F. Case Number OCR - Setup V6.0.1
+if /I "%~1"=="/GPU" goto gpu_setup
+title M.F. Case Number OCR - Setup V6.0.4 TEST
 set "PYTHON_EXE="
 set "APP_HOME=%~dp0"
-echo M.F. CASE NUMBER OCR V6.0.1 - INSTALL / REPAIR
+echo M.F. CASE NUMBER OCR V6.0.4 TEST - INSTALL / REPAIR
 echo.
 if exist "%LOCALAPPDATA%\Programs\Python\Python311\python.exe" set "PYTHON_EXE=%LOCALAPPDATA%\Programs\Python\Python311\python.exe"
 if not defined PYTHON_EXE (
@@ -67,3 +68,58 @@ echo Previously saved case files, settings and training remain untouched.
 echo If a shortcut exists, do not use it until dependencies are installed.
 pause
 exit /b 1
+
+:gpu_setup
+set "PYTHON_EXE="
+echo.
+echo MFCASE OPTIONAL NVIDIA GPU SETUP - USER ACTION ONLY
+echo This downloads public CUDA-enabled PyTorch from official pytorch.org.
+echo No PDFs, case numbers, training examples, or local logs are transmitted.
+echo CLOSE MFCASE before installing PyTorch; otherwise the program may fail.
+echo.
+if exist "%LOCALAPPDATA%\Programs\Python\Python311\python.exe" set "PYTHON_EXE=%LOCALAPPDATA%\Programs\Python\Python311\python.exe"
+if not defined PYTHON_EXE (
+  for /f "delims=" %%P in ('py -3.11 -c "import sys;print(sys.executable)" 2^>nul') do set "PYTHON_EXE=%%P"
+)
+if not defined PYTHON_EXE goto gpu_missing_python
+if not exist "!PYTHON_EXE!" goto gpu_missing_python
+"!PYTHON_EXE!" -c "import sys;assert sys.version_info[:2]==(3,11)"
+if errorlevel 1 goto gpu_missing_python
+where nvidia-smi >nul 2>nul
+if errorlevel 1 goto gpu_no_nvidia
+echo Detected NVIDIA driver tools:
+nvidia-smi --query-gpu=name,driver_version --format=csv,noheader
+if errorlevel 1 goto gpu_no_nvidia
+echo.
+echo If the NVIDIA driver is incompatible, PyTorch will report CUDA unavailable.
+echo No change to TrOCR model, learning data, crop geometry, or OCR thresholds.
+choice /C YN /M "MFCase is closed. Download and install NVIDIA CUDA PyTorch now"
+if errorlevel 2 goto gpu_cancel
+"!PYTHON_EXE!" -m pip install --upgrade torch torchvision --index-url https://download.pytorch.org/whl/cu126
+if errorlevel 1 goto gpu_failed
+"!PYTHON_EXE!" -c "import torch;print('PyTorch',torch.__version__,'CUDA build',torch.version.cuda,'CUDA available',torch.cuda.is_available());assert torch.cuda.is_available()"
+if errorlevel 1 goto gpu_unavailable
+echo SUCCESS - CUDA READY. Restart MFCase to use GPU inference.
+pause
+exit /b 0
+:gpu_missing_python
+echo Python 3.11 installation missing. First run SETUP.bat normally.
+pause
+exit /b 1
+:gpu_no_nvidia
+echo NVIDIA GPU/driver was not detected. CPU mode is unchanged.
+pause
+exit /b 1
+:gpu_cancel
+echo GPU setup canceled. Existing CPU/GPU environment is unchanged.
+exit /b 0
+:gpu_unavailable
+echo CUDA was installed but is not currently usable. MFCase can fall back to CPU.
+echo Check the NVIDIA driver and supported GPU before retrying. No PDF was uploaded.
+pause
+exit /b 1
+:gpu_failed
+echo GPU wheel installation failed. Existing case and learning files remain untouched.
+echo Run SETUP.bat normally if the Python environment requires repair.
+pause
+exit /b 1
